# Primary LLM Provider: 'groq' or 'openrouter'
PRIMARY_LLM_PROVIDER=groq

# Groq Configuration (Primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter Configuration (Automatic Fallback if Groq hits rate limits / token limits)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Allowed origins for CORS (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Specific Frontend URL in production (e.g. Vercel deployment)
FRONTEND_URL=https://your-frontend.vercel.app
